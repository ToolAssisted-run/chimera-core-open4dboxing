  "settings": [
    {
      "name": "video",
      "display": "Video Card",
      "type": "enum",
      "options": [
        "mcga",
        "ega",
        "cga",
        "tandy"
      ],
      "default": "mcga",
      "description": "Which of the game's four programs runs, one for each video card: the MCGA/VGA (256 colours, the default), the EGA (16 colours), the CGA (4 colours) or the Tandy 1000 (16 colours). The MCGA's program runs at the VGA's 70 frames a second, the others at 60. The game's properties (the boxers' health, stamina and endurance) are known for the MCGA's program only."
    },
    {
      "name": "sound",
      "display": "Sound",
      "type": "enum",
      "options": [
        "mt32",
        "sb",
        "adlib",
        "speaker",
        "tandy"
      ],
      "default": "mt32",
      "description": "The sound driver the game loads, as its setup chose it: the Roland MT-32 (the default), the Sound Blaster (its FM music with the digitised announcer and crowd), the AdLib, the PC speaker or the Tandy's sound chip. The MT-32 needs the two ROMs of an MT-32 (version 1.07, the first generation), which the project supplies as firmware."
    },
    {
      "name": "cpu_speed",
      "display": "CPU Speed",
      "type": "int",
      "default": 22000,
      "min": 1000,
      "max": 10000000,
      "description": "The PC's speed, as DOSBox's cycles: the instructions it runs a millisecond (the default, 22,000, is the 486 of the DOSBox-X machine Open4DBoxing was checked against). The game's frames take its time, and in a fight the boxers' moves go by the game's timer: at 220,000 every frame fits in one of the timer's 10 ms ticks, and the fight goes the same whatever the frames draw. A movie records the speed it ran with."
    },
    {
      "name": "clock_start",
      "display": "Start Date and Time",
      "type": "string",
      "default": "1991-07-30 14:47:00",
      "description": "The PC's date and time when the game starts, written as YYYY-MM-DD HH:MM:SS (the default is the date of the game's programs on its floppies). The clock then advances with the game, and the BIOS's tick count starts from the time of day. A movie records the start time it ran with."
    }
  ],
  "firmware": [
    {
      "id": "disk1.img",
      "display": "4D Sports Boxing disk1.img",
      "description": "disk1.img, the image of the first floppy, with the four programs (MCGA/VGA, EGA, CGA, Tandy) and the sound drivers of 4D Sports Boxing (Distinctive Software, 1991, DOS), a 720 KB floppy. You have to supply it, because this package includes none of the game's files. Open4DBoxing reads the game's files from the image as the original read them from the floppy, and never writes to it. Another image of the same floppy, or one of your own, can be used in its place, and the project then records its hash.",
      "size": 737280,
      "sha1": "5B324ABEC67BAA90A44C04BB9CC82BA50F4FB962",
      "name": "disk1.img"
    },
    {
      "id": "disk2.img",
      "display": "4D Sports Boxing disk2.img",
      "description": "disk2.img, the image of the second floppy, with the rings, the boxers' heads and the rest of the pictures and sounds of 4D Sports Boxing (Distinctive Software, 1991, DOS), a 720 KB floppy. You have to supply it, because this package includes none of the game's files. Open4DBoxing reads the game's files from the image as the original read them from the floppy, and never writes to it. Another image of the same floppy, or one of your own, can be used in its place, and the project then records its hash.",
      "size": 737280,
      "sha1": "C63AA4787B3A7860EC07B171AD3B47DA1A41E58E",
      "name": "disk2.img"
    },
    {
      "id": "MT32_CONTROL.ROM",
      "display": "Roland MT-32 control ROM",
      "description": "MT32_CONTROL.ROM is not one of the game's files. It is the control ROM of the Roland MT-32, version 1.07, dumped from a unit of the first generation. You have to supply it when the sound is the MT-32's, because this package includes none of it. Another MT-32 ROM that Munt knows can be used in its place, and the project then records its hash.",
      "size": 65536,
      "sha1": "B083518FFFB7F66B03C23B7EB4F868E62DC5A987",
      "name": "MT32_CONTROL.ROM",
      "requiredWhen": {
        "setting": "sound",
        "in": [
          "mt32"
        ]
      }
    },
    {
      "id": "MT32_PCM.ROM",
      "display": "Roland MT-32 PCM ROM",
      "description": "MT32_PCM.ROM is not one of the game's files. It is the PCM ROM of the Roland MT-32, which is the same in every MT-32. You have to supply it when the sound is the MT-32's, because this package includes none of it. Another MT-32 ROM that Munt knows can be used in its place, and the project then records its hash.",
      "size": 524288,
      "sha1": "F6B1EEBC4B2D200EC6D3D21D51325D5B48C60252",
      "name": "MT32_PCM.ROM",
      "requiredWhen": {
        "setting": "sound",
        "in": [
          "mt32"
        ]
      }
    }
  ]
}
